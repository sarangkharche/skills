<?xml version='1.0' encoding='utf-8'?>
<mxfile>
  <diagram name="Article review">
    <mxGraphModel background="#ffffff" grid="0" adaptiveColors="none">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="draft" parent="1" vertex="1" value="Draft article" style="rounded=1;arcSize=15;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#DFE5FF;strokeColor=#7065EE;">
          <mxGeometry x="20" y="20" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="review" parent="1" vertex="1" value="Review draft" style="rounded=1;arcSize=15;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#FFF0A8;strokeColor=#C6B54D;">
          <mxGeometry x="188" y="20" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="publish" parent="1" vertex="1" value="Publish article" style="rounded=1;arcSize=15;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#DDF0E1;strokeColor=#6A9B77;">
          <mxGeometry x="356" y="20" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="draftToreview" parent="1" edge="1" source="draft" target="review" style="html=1;endArrow=block;endFill=1;strokeColor=#111111;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="reviewTopublish" parent="1" edge="1" source="review" target="publish" style="html=1;endArrow=block;endFill=1;strokeColor=#111111;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>